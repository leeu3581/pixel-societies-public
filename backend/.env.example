# Copy to backend/.env. Never commit the completed file.
# Local setup: Supabase CLI database + storage, FastAPI self-hosted auth.
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Local values: run `supabase status -o env`. Use JWT_SECRET and SERVICE_ROLE_KEY.
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Required for interpretation, profile readings, wiki synthesis and images.
LLM_PROVIDER=meta
META_API_KEY=
META_MODEL=muse-spark-1.3
TWIN_MEMORY_AI_ENABLED=1
TWIN_DISCOVERY_ENABLED=1
# Keeps unrelated agents and autonomous loops off, not the enabled twin pipeline.
LLM_DISABLED=1
DISABLE_ENGINE_LOOP=1
DISABLE_SOCIETY_LOOP=1
# Optional transcription API; no separate model key. Not a complete voice UI.
META_VOICE_ENABLED=0

# Optional Azure Blob storage instead of Supabase storage.
# Leave AZURE_STORAGE_ACCOUNT empty for the local quick start.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_SPRITES_CONTAINER=sprites
AZURE_STORAGE_SPRITES_SAS=

# Optional Gmail connection (not Google sign-in).
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/profile/gmail
# Generate once with Fernet.generate_key(); keep stable across restarts.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Optional Azure OpenAI interpretation instead of Meta text.
# Set LLM_PROVIDER=azure and supply all three. Images still require META_API_KEY.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Optional legacy agents/interview integrations; not required by the main flow.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
DEVIN_SERVICE_API_KEY=
MONTY_SIDECAR_URL=http://localhost:8001
MONTY_SIDECAR_SECRET=

# Optional remote observability. Off for a local run.
LOGFIRE_SEND_TO_LOGFIRE=false
LOGFIRE_SERVICE_NAME=pixel-societies-backend
LOGFIRE_ENVIRONMENT=local
# LOGFIRE_TOKEN=
